{
  "id": "PHONE",
  "label": "Phone number",
  "order": 2,
  "priority": 50,
  "region": "International, GCC, India",
  "validation": "International numbers need + or 00 and 8-15 digits (E.164 maximum is 15). Local formats: GCC mobiles 05X XXX XXXX, Indian mobiles starting 6-9",
  "sources": [
    "https://www.itu.int/rec/T-REC-E.164",
    "https://github.com/google/libphonenumber/blob/master/resources/PhoneNumberMetadata.xml"
  ],
  "notes": "Local landline numbers without a country code are not detected: they look like too many other numbers.",
  "patterns": [
    {
      "name": "international",
      "regex": "(?<![0-9A-Za-z+])(?:\\+|00)[1-9][0-9]{0,2}(?:[ ]?\\(0\\))?[ .-]?(?:\\([0-9]{1,5}\\)|[0-9]{1,5})(?:[ .-]?(?:\\([0-9]{2,5}\\)|[0-9]{2,5})){1,5}(?![0-9])",
      "validator": "e164",
      "params": {
        "min_digits": 8,
        "max_digits": 15
      }
    },
    {
      "name": "gcc_mobile_local",
      "regex": "(?<![0-9A-Za-z+])05[0-9][ -]?[0-9]{3}[ -]?[0-9]{4}(?![0-9])"
    },
    {
      "name": "india_mobile_local",
      "regex": "(?<![0-9A-Za-z+])0?[6-9][0-9]{4}[ -]?[0-9]{5}(?![0-9])"
    }
  ],
  "examples": {
    "valid": [
      "+971 50 123 4567",
      "+971501234567",
      "00966 55 123 4567",
      "+974 3312 4567",
      "+965 6012 3456",
      "+973 3612 3456",
      "+968 9123 4567",
      "+91 98765 43210",
      "+1 (555) 010-9999",
      "+971 (0)4 123 4567",
      "050 123 4567",
      "0551234567",
      "98765 43210",
      "09876543210",
      "+971 4 000 0000",
      "+91 80 2222 3333"
    ],
    "invalid": [
      "+12 34",
      "+971 50 123 4567 1234 5678",
      "1234567890",
      "12345 67890",
      "05 12"
    ]
  }
}
