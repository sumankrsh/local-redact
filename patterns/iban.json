{
  "id": "IBAN",
  "label": "IBAN",
  "order": 3,
  "priority": 85,
  "region": "89 IBAN countries, including AE, SA, QA, KW, BH, OM",
  "validation": "Country-specific length from the SWIFT IBAN registry, then the ISO 13616 mod-97 check",
  "sources": [
    "https://www.swift.com/swift-resource/11971/download",
    "https://github.com/arthurdejong/python-stdnum/blob/master/stdnum/iban.dat"
  ],
  "notes": "Lengths are from the SWIFT IBAN registry (89 countries, matching python-stdnum's iban.dat). India has no IBAN. Only upper-case IBANs, compact or in groups separated by single spaces, are detected.",
  "patterns": [
    {
      "name": "iban",
      "regex": "(?<![A-Za-z0-9])[A-Z]{2}[0-9]{2}(?:[ ]?[A-Z0-9]){11,30}(?![A-Za-z0-9])",
      "validator": "iban",
