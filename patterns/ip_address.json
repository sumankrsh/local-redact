{
  "id": "IP_ADDRESS",
  "label": "IP address",
  "order": 9,
  "priority": 60,
  "region": "Global",
  "validation": "IPv4: four octets 0-255, no leading zeros. IPv6: full RFC 4291 text form, including :: and a dotted IPv4 tail",
  "sources": [
    "https://www.rfc-editor.org/rfc/rfc791",
    "https://www.rfc-editor.org/rfc/rfc4291#section-2.2"
  ],
  "notes": "IPv6 forms with fewer than two non-zero groups (such as ::1) are skipped to avoid noise from code like std::vector. Version strings such as 1.2.3.4 are valid IPv4 addresses and will be redacted.",
  "patterns": [
    {
      "name": "ipv4",
      "regex": "(?<![0-9A-Za-z.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9A-Za-z]|\\.[0-9])",
      "validator": "ipv4"
    },
    {
      "name": "ipv6",
      "regex": "(?<![0-9A-Za-z:.])(?:[0-9A-Fa-f]{0,4}:){2,7}(?:[0-9A-Fa-f]{1,4}|[0-9]{1,3}(?:\\.[0-9]{1,3}){3})?(?![0-9A-Za-z:]|\\.[0-9])",
      "validator": "ipv6",
      "params": {
        "min_groups": 2
      }
    }
  ],
  "examples": {
    "valid": [
      "10.24.3.17",
      "203.0.113.45",
      "2001:db8:85a3::8a2e:370:7334",
      "fe80::1ff:fe23:4567:890a",
      "::ffff:192.0.2.128",
      "2001:0db8:0000:0000:0000:ff00:0042:8329"
    ],
    "invalid": [
      "256.1.1.1",
      "10.01.2.3",
      "1.2.3",
      "12:30:45",
      "00:1A:2B:3C:4D:5E",
      "::1",
      "std::vector",
      "2001:db8::1::2"
    ]
  }
}
