{
  "id": "CARD",
  "label": "Payment card number",
  "order": 4,
  "priority": 80,
  "region": "Global",
  "validation": "13-19 digits, a known card-scheme prefix, and the Luhn check (ISO/IEC 7812-1)",
  "sources": [
    "https://en.wikipedia.org/wiki/Luhn_algorithm",
    "https://en.wikipedia.org/wiki/Payment_card_number",
    "https://docs.stripe.com/testing"
  ],
  "notes": "Prefixes: Visa 4; Mastercard 51-55, 2221-2720; Amex 34, 37; Discover 6011, 644-649, 65; JCB 3528-3589; Diners 30, 36, 38, 39; UnionPay 62; RuPay 60, 65, 81, 82, 508; Maestro 5018, 5020, 5038, 5893, 6304, 6759, 6761-6763. Numbers may be compact, in groups of four, or 4-6-5 (Amex), with one kind of separator. 12-digit Maestro cards are not detected.",
  "patterns": [
    {
      "name": "compact",
      "regex": "(?<![0-9A-Za-z])[0-9]{13,19}(?![0-9A-Za-z])",
      "validator": "luhn",
      "params": {
        "min_length": 13,
        "max_length": 19,
        "prefixes": [
          "4",
          "51-55",
          "2221-2720",
          "34",
          "37",
          "6011",
          "644-649",
          "65",
          "3528-3589",
          "30",
          "36",
          "38",
          "39",
          "62",
          "60",
          "81",
          "82",
          "508",
          "5018",
          "5020",
          "5038",
          "5893",
          "6304",
          "6759",
          "6761-6763"
        ]
      }
    },
    {
      "name": "grouped_4",
      "regex": "(?<![0-9A-Za-z])[0-9]{4}([ -])[0-9]{4}\\1[0-9]{4}\\1[0-9]{1,4}(?:\\1[0-9]{1,3})?(?![0-9A-Za-z])",
      "validator": "luhn",
      "params": {
        "min_length": 13,
        "max_length": 19,
        "prefixes": [
          "4",
          "51-55",
          "2221-2720",
          "34",
          "37",
          "6011",
          "644-649",
          "65",
          "3528-3589",
          "30",
          "36",
          "38",
          "39",
          "62",
          "60",
          "81",
          "82",
          "508",
          "5018",
          "5020",
          "5038",
          "5893",
          "6304",
          "6759",
          "6761-6763"
        ]
      }
    },
    {
      "name": "grouped_4_6",
      "regex": "(?<![0-9A-Za-z])[0-9]{4}([ -])[0-9]{6}\\1[0-9]{4,5}(?![0-9A-Za-z])",
      "validator": "luhn",
      "params": {
        "min_length": 13,
        "max_length": 19,
        "prefixes": [
          "4",
          "51-55",
          "2221-2720",
          "34",
          "37",
          "6011",
          "644-649",
          "65",
          "3528-3589",
          "30",
          "36",
          "38",
          "39",
          "62",
          "60",
          "81",
          "82",
          "508",
          "5018",
          "5020",
          "5038",
          "5893",
          "6304",
          "6759",
          "6761-6763"
        ]
      }
    }
  ],
  "examples": {
    "valid": [
      "4242 4242 4242 4242",
      "4111111111111111",
      "5555-5555-5555-4444",
      "2223003122003222",
      "3782 822463 10005",
      "6011111111111117",
      "3566002020360505",
      "36227206271667",
      "6200000000000005"
    ],
    "invalid": [
      "4242 4242 4242 4241",
      "1234 5678 9012 3456",
      "4242 4242-4242 4242",
      "0000 0000 0000 0000",
      "7842005000000011"
    ]
  }
}
