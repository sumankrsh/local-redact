{
  "id": "SECRET",
  "label": "API key, token or private key",
  "order": 10,
  "priority": 95,
  "region": "Global",
  "validation": "Vendor prefix plus exact length or character set. JWTs must have a header that decodes to JSON with an \"alg\" field",
  "sources": [
    "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html",
    "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/about-authentication-to-github",
    "https://github.blog/changelog/2026-10-02-stateless-github-app-installation-tokens-rolled-out/",
    "https://docs.slack.dev/authentication/tokens",
    "https://docs.stripe.com/keys",
    "https://github.com/gitleaks/gitleaks/blob/master/config/gitleaks.toml",
    "https://www.rfc-editor.org/rfc/rfc7519",
    "https://www.rfc-editor.org/rfc/rfc7515#section-4.1.1",
    "https://www.rfc-editor.org/rfc/rfc7468",
    "https://www.rfc-editor.org/rfc/rfc5915"
  ],
  "notes": "Prefixes come from vendor docs (AWS, GitHub, Slack, Stripe). Vendors rarely document lengths, so lengths and character sets follow the open-source gitleaks rules. Google, OpenAI and Anthropic key shapes also follow gitleaks. JWTs (signed, 3 parts, or encrypted, 5 parts) must have a first part that decodes to a JSON object with an \"alg\" member. Random-looking secrets without a known prefix (for example a password in a config file) are not detected; add a custom pattern for those.",
  "patterns": [
    {
      "name": "aws_access_key_id",
      "regex": "(?<![A-Za-z0-9])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Za-z0-9])"
    },
    {
      "name": "github_token",
      "regex": "(?<![A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{36}(?![A-Za-z0-9_])"
    },
    {
      "name": "github_installation_token",
      "regex": "(?<![A-Za-z0-9_])ghs_[A-Za-z0-9]{1,40}_[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+){2}(?![A-Za-z0-9_-])"
    },
    {
      "name": "github_fine_grained_pat",
      "regex": "(?<![A-Za-z0-9_])github_pat_[A-Za-z0-9_]{82}(?![A-Za-z0-9_])"
    },
    {
      "name": "slack_token",
      "regex": "(?<![A-Za-z0-9.-])(?:xox[abposre]|xapp|xwfp|xoxe\\.(?:xoxb|xoxp|xapp))-[A-Za-z0-9-]{10,250}(?![A-Za-z0-9-])"
    },
    {
      "name": "stripe_secret_key",
      "regex": "(?<![A-Za-z0-9_])(?:(?:sk|rk)_(?:live|test|prod)|sk_org)_[A-Za-z0-9]{10,247}(?![A-Za-z0-9_])"
    },
    {
      "name": "google_api_key",
      "regex": "(?<![A-Za-z0-9_-])AIza[A-Za-z0-9_-]{35}(?![A-Za-z0-9_-])"
    },
    {
      "name": "anthropic_api_key",
      "regex": "(?<![A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{32,}(?![A-Za-z0-9_-])"
    },
    {
      "name": "openai_api_key",
      "regex": "(?<![A-Za-z0-9_-])sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{32,}|[A-Za-z0-9]{32,})(?![A-Za-z0-9_-])"
    },
    {
      "name": "jwt",
      "regex": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]*)?(?![A-Za-z0-9_-])",
      "validator": "jwt"
    },
    {
      "name": "bearer_token",
      "regex": "(?<=[Bb]earer )[A-Za-z0-9._~+/-]{20,}=*(?![A-Za-z0-9._~+/=-])"
    },
    {
      "name": "private_key_block",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]{1,20000}?-----END (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----"
    }
  ],
  "examples": {
    "valid": [
      "AKIAIOSFODNN7EXAMPLE",
      "ghp_EXAMPLE00000000000000000000000000000",
      "xoxb-EXAMPLE-not-a-real-token",
      "sk_test_EXAMPLE00000000000000000000",
      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTEyMyIsIm5hbWUiOiJUZXN0IFVzZXIifQ.c2lnbmF0dXJlLWV4YW1wbGU",
      "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ\n-----END PRIVATE KEY-----",
      "ghs_123456_eyJhbGciOiJSUzI1NiJ9.eyJpc3MiOiIxMjM0NTYifQ.c2lnbmF0dXJlLWV4YW1wbGU",
      "eyJhbGciOiJub25lIn0.eyJzdWIiOiJ0ZXN0In0."
    ],
    "invalid": [
      "AKIA1234",
      "ghp_short",
      "sk-learn-is-a-python-package",
      "eyJub3Rqc29u.eyJhIjoxfQ.sig",
      "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqh\n-----END PUBLIC KEY-----"
    ]
  }
}
